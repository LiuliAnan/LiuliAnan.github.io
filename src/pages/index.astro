---
import '../styles/global.css';

const skills = [
  'Agent Loop', 'Function Calling', 'RAG', 'Python', 'FastAPI',
  'C++', 'Next.js', 'NestJS', 'PostgreSQL', 'Docker'
];

const projects = [
  {
    number: '01',
    title: 'Code Agent',
    label: 'AI AGENT / PYTHON',
    intro: '一个会规划、执行、观察并持续迭代的轻量级代码智能体。',
    body: '不是一次性生成答案，而是一套可扩展的执行运行时：Planner 强制输出 JSON Action，经 Pydantic 校验后交给工具注册表；每次执行都返回统一 Observation，再写回状态推动下一轮规划。',
    metrics: ['4 类工具', '最多 10 步', '多任务记忆'],
    stack: ['Python', 'DeepSeek API', 'Pydantic', 'LangChain'],
    highlights: [
      ['可靠边界', '未知工具、缺参、超时与权限错误统一收敛为 Observation，不打断循环。'],
      ['上下文管理', '超过阈值后摘要较早历史，同时保留最近 4 条消息，控制上下文增长。'],
      ['可扩展设计', 'Planner、Runtime、Executor 与 Tool 解耦，新增工具只需实现抽象接口并注册。']
    ],
    note: '当前实现 · CLI 交互 / DeepSeek / read_file / write_file / run_shell / finish',
    href: 'https://github.com/LiuliAnan/code-agent',
    visual: 'agent'
  },
  {
    number: '02',
    title: 'Fullstack Dashboard',
    label: 'FULL STACK / DATA VISUALIZATION',
    intro: '从认证、数据建模到交互式图表的一体化全栈数据产品。',
    body: '围绕供应链公司数据完成从数据库到交互界面的闭环：后端提供认证、事务 CRUD、聚合与层级查询，前端把同一组组合筛选状态同步到条形图和可缩放气泡层级图。',
    metrics: ['2K 公司 + 2K 关系', '6 维组合筛选', '12/12 E2E'],
    stack: ['Next.js', 'NestJS', 'PostgreSQL', 'D3', 'Docker'],
    highlights: [
      ['层级查询', '过滤命中公司后补全其祖先链，以 matched 标记区分命中节点与结构上下文。'],
      ['数据体验', 'Chart.js 动态分组与 D3 Circle Packing 共享筛选，支持缩放、Tooltip 和响应式重排。'],
      ['工程完整性', 'JWT、bcrypt、事务、迁移、Swagger、CSV 自动导入，并覆盖 12 项后端 E2E 测试。']
    ],
    note: '当前实现 · 4 个统计指标 / 用户与公司管理 / Bar + Bubble Explorer',
    href: 'https://github.com/LiuliAnan/fullstack-dashboard',
    visual: 'dashboard'
  }
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="刘洺远的个人作品集，聚焦 AI Agent、LLM 应用与全栈数据产品。" />
    <meta name="theme-color" content="#0a0c10" />
    <title>刘洺远｜AI 应用开发工程师</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="返回首页">LMY<span>.</span></a>
      <nav aria-label="主导航">
        <a href="#projects">项目</a>
        <a href="#about">关于</a>
        <a href="#contact">联系</a>
      </nav>
      <a class="nav-cta" href="https://github.com/LiuliAnan" target="_blank" rel="noreferrer">GitHub <span>↗</span></a>
    </header>

    <main id="top">
      <section class="hero section-shell">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> AVAILABLE FOR OPPORTUNITIES · 2026</p>
          <h1>构建真正<br /><em>能执行</em>的 AI 应用。</h1>
          <p class="hero-lead">你好，我是刘洺远。专注于 Agent 工程、LLM 应用与 Python 后端，喜欢把模型能力变成可验证、可维护的工程系统。</p>
          <div class="hero-actions">
            <a class="button primary" href="#projects">探索项目 <span>↓</span></a>
            <a class="button ghost" href="mailto:liuliananlmy@163.com">联系我 <span>↗</span></a>
          </div>
        </div>
        <div class="hero-system" aria-label="AI Agent 系统运行状态">
          <div class="system-head">
            <span><i></i> AGENT SYSTEM / ONLINE</span>
            <b>LMY.2026</b>
          </div>
          <div class="orbit-stage">
            <div class="orbit orbit-one"><i></i></div>
            <div class="orbit orbit-two"><i></i></div>
            <div class="orbit orbit-three"><i></i></div>
            <div class="core"><span>AI</span><small>APPLICATION<br />ENGINEER</small></div>
            <span class="node node-a">PLAN</span>
            <span class="node node-b">ACT</span>
            <span class="node node-c">OBSERVE</span>
            <span class="node node-d">REFLECT</span>
          </div>
          <div class="system-feed">
            <p><span>01</span><b>Action validated</b><em>Pydantic</em></p>
            <p><span>02</span><b>Tool registry</b><em>4 tools</em></p>
            <p><span>03</span><b>History compressor</b><em class="live">active</em></p>
          </div>
          <div class="signal"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
        </div>
      </section>

      <section class="ticker" aria-label="技能概览">
        <div>{skills.map((skill) => <><span>{skill}</span><b>✦</b></>)}</div>
      </section>

      <section id="projects" class="projects section-shell">
        <div class="section-heading">
          <div><p class="kicker">SELECTED WORK</p><h2>代表项目</h2></div>
          <p>从智能体运行时到底层数据模型，关注完整链路和可落地的工程结果。</p>
        </div>

        <div class="project-list">
          {projects.map((project) => (
            <article class="project-card">
              <div class="project-copy">
                <div class="project-meta"><span>{project.number}</span><b>{project.label}</b></div>
                <h3>{project.title}</h3>
                <p class="project-intro">{project.intro}</p>
                <p class="project-body">{project.body}</p>
                <ul class="metrics">{project.metrics.map((metric) => <li>{metric}</li>)}</ul>
                <div class="stack">{project.stack.map((item) => <span>{item}</span>)}</div>
                <div class="project-highlights">
                  {project.highlights.map(([title, text]) => (
                    <div><b>{title}</b><p>{text}</p></div>
                  ))}
                </div>
                <p class="project-note">{project.note}</p>
                <a class="project-link" href={project.href} target="_blank" rel="noreferrer">查看 GitHub 仓库 <span>↗</span></a>
              </div>
              <div class={`project-visual ${project.visual}`} aria-hidden="true">
                {project.visual === 'agent' ? (
                  <div class="agent-ui">
                    <div class="window-bar"><i></i><i></i><i></i><span>agent_runtime.py</span></div>
                    <div class="flow-row"><b>01</b><span><small>PLANNER</small>JSON Action + Schema 校验</span><em>✓</em></div>
                    <div class="flow-line"></div>
                    <div class="flow-row active"><b>02</b><span><small>EXECUTOR</small>Registry 分发对应 Tool</span><em>•••</em></div>
                    <div class="flow-line"></div>
                    <div class="flow-row"><b>03</b><span><small>OBSERVATION</small>结果写回 AgentState</span><em>↻</em></div>
                    <div class="code-line"><span>$</span> agent.run(<b>"build the feature"</b>)</div>
                  </div>
                ) : (
                  <div class="dashboard-ui">
                    <div class="dash-side"><strong>LMY</strong><i></i><i></i><i></i><i></i></div>
                    <div class="dash-main">
                      <div class="dash-top"><b>Supply Chain Explorer</b><span>⌕ &nbsp; ●</span></div>
                      <div class="stat-grid"><span><small>COMPANIES</small><b>2,000</b></span><span><small>REVENUE</small><b>$182.8M</b></span><span><small>COUNTRIES</small><b>08</b></span></div>
                      <div class="chart-grid">
                        <div class="bars"><i style="--h:45%"></i><i style="--h:72%"></i><i style="--h:58%"></i><i style="--h:90%"></i><i style="--h:66%"></i><i style="--h:82%"></i></div>
                        <div class="bubbles"><i></i><i></i><i></i><i></i><i></i><small>ancestor context<br />preserved</small></div>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="about" class="about section-shell">
        <div class="about-number">03</div>
        <div class="about-main">
          <p class="kicker">ABOUT ME</p>
          <h2>不止调用模型，<br />更关注系统如何可靠运行。</h2>
          <p>UNSW Database Systems 硕士，专业前 5%。我从数据工程和 Python 后端出发，逐步深入 Agent Loop、Function Calling、RAG 与代码自修复机制。面对一个 AI 功能，我会同时追问：结果如何评估？失败如何恢复？上下文如何管理？系统如何部署？</p>
        </div>
        <div class="about-side">
          <div><span>01</span><p><strong>Agent Engineering</strong>规划、工具调用、观察反馈与自修复闭环</p></div>
          <div><span>02</span><p><strong>Backend & Data</strong>API、数据建模、ETL、检索与容器化</p></div>
          <div><span>03</span><p><strong>Product Thinking</strong>从真实问题、指标和用户体验反推实现</p></div>
        </div>
      </section>

      <section class="proof section-shell">
        <div><strong>TOP 5%</strong><span>UNSW 专业排名</span></div>
        <div><strong>10K+</strong><span>NLP 文本样本</span></div>
        <div><strong>15%</strong><span>尾部类别召回提升</span></div>
        <div><strong>1 + 1</strong><span>发明专利与软件著作权</span></div>
      </section>

      <section id="contact" class="contact section-shell">
        <p class="kicker">LET'S BUILD SOMETHING</p>
        <h2>有值得解决的问题？<br /><em>一起聊聊。</em></h2>
        <div class="contact-row">
          <a href="mailto:liuliananlmy@163.com">liuliananlmy@163.com <span>↗</span></a>
          <a href="https://github.com/LiuliAnan" target="_blank" rel="noreferrer">GitHub / LiuliAnan <span>↗</span></a>
        </div>
      </section>
    </main>

    <footer class="site-footer"><span>© 2026 刘洺远</span><span>DESIGNED & BUILT WITH CARE</span><a href="#top">BACK TO TOP ↑</a></footer>
    <script>
      const revealItems = document.querySelectorAll('.project-card, .about-main, .about-side, .proof, .contact');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add('is-visible'));
      }, { threshold: 0.12 });
      revealItems.forEach((item) => observer.observe(item));

      const system = document.querySelector('.hero-system');
      system?.addEventListener('pointermove', (event) => {
        const rect = system.getBoundingClientRect();
        system.style.setProperty('--mx', `${event.clientX - rect.left}px`);
        system.style.setProperty('--my', `${event.clientY - rect.top}px`);
      });
    </script>
  </body>
</html>
